[Desktop Entry]
Type=Application
Name=Bandstand
GenericName=Music Player
Comment=Search YouTube Music, play songs and keep playlists
Exec=bandstand %U
Icon=bandstand
Categories=AudioVideo;Audio;Player;
StartupWMClass=bandstand
MimeType=audio/mpeg;audio/x-mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-oggflac;audio/vorbis;audio/x-vorbis;audio/x-vorbis+ogg;audio/opus;audio/x-wav;audio/wav;audio/mp4;audio/x-m4a;audio/aac;audio/x-ms-wma;audio/x-musepack;
